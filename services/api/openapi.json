{
  "openapi": "3.1.0",
  "info": {
    "title": "Obriy API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Ready",
        "operationId": "ready_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Live",
        "operationId": "live_api_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheckResult": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "status",
          "latency_ms",
          "detail"
        ],
        "title": "CheckResult"
      },
      "Checks": {
        "properties": {
          "db": {
            "$ref": "#/components/schemas/CheckResult"
          }
        },
        "type": "object",
        "required": [
          "db"
        ],
        "title": "Checks"
      },
      "LiveResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "LiveResponse"
      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "checks": {
            "$ref": "#/components/schemas/Checks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessResponse"
      },
      "Telemetry": {
        "additionalProperties": false,
        "properties": {
          "vehicle_id": {
            "title": "Vehicle Id",
            "type": "string"
          },
          "lat": {
            "maximum": 90,
            "minimum": -90,
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "maximum": 180,
            "minimum": -180,
            "title": "Lon",
            "type": "number"
          },
          "alt_rel_m": {
            "title": "Alt Rel M",
            "type": "number"
          },
          "groundspeed_mps": {
            "minimum": 0,
            "title": "Groundspeed Mps",
            "type": "number"
          },
          "heading_deg": {
            "exclusiveMaximum": 360,
            "minimum": 0,
            "title": "Heading Deg",
            "type": "number"
          },
          "battery_voltage_v": {
            "minimum": 0,
            "title": "Battery Voltage V",
            "type": "number"
          },
          "battery_remaining_pct": {
            "anyOf": [
              {
                "maximum": 100,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Battery Remaining Pct"
          }
        },
        "required": [
          "vehicle_id",
          "lat",
          "lon",
          "alt_rel_m",
          "groundspeed_mps",
          "heading_deg",
          "battery_voltage_v",
          "battery_remaining_pct"
        ],
        "title": "Telemetry",
        "type": "object"
      },
      "TelemetryMessage": {
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "telemetry",
            "default": "telemetry",
            "title": "Type",
            "type": "string"
          },
          "ts": {
            "minimum": 0,
            "title": "Ts",
            "type": "integer"
          },
          "payload": {
            "$ref": "#/components/schemas/Telemetry"
          }
        },
        "required": [
          "type",
          "ts",
          "payload"
        ],
        "title": "TelemetryMessage",
        "type": "object"
      }
    }
  }
}
